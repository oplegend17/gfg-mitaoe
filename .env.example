VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# The ONE admin email (must match the user you create in Firebase Auth
# and the email inside firestore.rules)
VITE_ADMIN_EMAIL=

# Public URL students land on (your Vercel URL). Used for the QR code.
VITE_PUBLIC_URL=https://your-app.vercel.app

# Expected turnout, used for the progress bar only
VITE_EXPECTED_COUNT=300
